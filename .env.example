# Growatt Cloud Configuration
# Copy this file to .env and fill in your values

# Your ShineWiFi dongle serial number (found on dongle sticker)
GROWATT_DATALOGGER_SERIAL=your_datalogger_serial_here

# Your inverter serial number (found on inverter sticker or ShinePhone app)
GROWATT_INVERTER_SERIAL=your_inverter_serial_here

# Growatt server (use server-us.growatt.com for North America)
GROWATT_SERVER=server.growatt.com
GROWATT_PORT=5279

# Inverter Modbus settings (used by growatt_gateway.py only)
MODBUS_PORT=/dev/ttyUSB0
MODBUS_BAUDRATE=9600
MODBUS_DEVICE_ID=1

# Local gateway (growatt_gateway.py) -- growatt_cloud.py and any other local
# consumer read from this HTTP API instead of opening the Modbus port
# directly. See docs/GATEWAY.md.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090
GATEWAY_POLL_INTERVAL=15
GATEWAY_STALE_AFTER=90
# Consecutive total-read-failure cycles (every register failing, not just
# one) before the gateway closes and reopens the serial connection itself.
GATEWAY_RECONNECT_AFTER_FAILURES=3

# growatt_watchdog.py -- reboots the Pi if the gateway stays unhealthy
# longer than a soft reconnect can fix (see docs/GATEWAY.md). Mirrors the
# huawei-monitor modem watchdog pattern already used on rancho-main-pi.
GATEWAY_WATCHDOG_INTERVAL=60
GATEWAY_WATCHDOG_FAILURE_LIMIT=10
GATEWAY_WATCHDOG_UNHEALTHY_AGE=300
GATEWAY_WATCHDOG_COOLDOWN=3600

# Optional: Growatt Portal Credentials (for API queries only)
# These are your ShinePhone app login credentials
GROWATT_USERNAME=your_username
GROWATT_PASSWORD=your_password

# Optional: Growatt Open API token (create one at server.growatt.com under
# your account). Query https://openapi.growatt.com/v1/... with this as the
# "token" header -- NOT server.growatt.com, that domain rejects v1 API calls.
GROWATT_API_TOKEN=your_open_api_token
